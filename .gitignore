# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Công cụ test
tool/models/
tool/.venv/

# Dữ liệu công khai tải về: chỉ dùng nội bộ, không commit (giấy phép riêng)
dataset/public/*/videos/

# Ảnh tách từ video để đánh giá ML Kit trên điện thoại
dataset/eval_frames/

# Dữ liệu lớn (6,5 GB, giấy phép riêng) và video demo: không đưa vào git
/dataset/
/demo/*
# Riêng video so sánh trước/sau của báo cáo đồ hoạ (mục 12) được đưa vào git để
# báo cáo xem được khi clone; bản quay gốc, tiếng, clip lẻ chỉ giữ trên máy.
!/demo/motion/
/demo/motion/*
!/demo/motion/compare_*.mp4
!/demo/motion/compare_*.jpg

# Bản sao lưu tự động của Blender
*.blend1
# File .blend do script tool/blender/ sinh lại được
/art_src/blender/*.blend
# Hộp thư Tripo: mọi lần sinh được addon chép tự động — chỉ model đã đặt tên
# (nút "Gửi vào repo", art_src/tripo/<tên>/) mới commit (Git LFS)
/art_src/tripo/_inbox/
__pycache__/
# Dữ liệu mocap thô tải lại được bằng tool/mocap/fetch.py
/art_src/mocap/_cache/
/tool/.venv-ml/
